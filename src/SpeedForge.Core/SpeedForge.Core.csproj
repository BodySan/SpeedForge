<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SpeedForge.Core</AssemblyName>
    <RootNamespace>SpeedForge.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="servers.json" />
    <EmbeddedResource Include="server-observations.json" />
    <EmbeddedResource Include="city-locations.json" />
    <EmbeddedResource Include="Bundled/iperf3.zip" />
    <EmbeddedResource Include="Bundled/iperf3-hashes.json" />
    <EmbeddedResource Include="Bundled/iperf2.zip" />
    <EmbeddedResource Include="Bundled/iperf2-hashes.json" />
    <EmbeddedResource Include="Bundled/iperf2-legacy.zip" />
    <EmbeddedResource Include="Bundled/iperf2-legacy-hashes.json" />
    <EmbeddedResource Include="..\..\third-party\**\*" Exclude="..\..\third-party\source\extracted\**\*">
      <LogicalName>SpeedForge.Licenses.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
