<Window x:Class="SpeedForge.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SpeedForge 1.1.2" Icon="/Assets/SpeedForge.ico" Width="1000" Height="800" MinWidth="840" MinHeight="700" Background="#0B121D" Foreground="#EAF1FC" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
<Window.Resources><Style TargetType="TabItem"><Setter Property="Foreground" Value="#92A6BF"/><Setter Property="Padding" Value="16,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="#EAF1FC"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#14202F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Window.Resources>
<Grid Background="#0B121D"><Grid Margin="30,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<DockPanel Margin="0,0,0,12"><TextBlock x:Name="CatalogCount" Foreground="{StaticResource DownloadTone}" DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center"/><StackPanel><StackPanel Orientation="Horizontal"><Image Source="/Assets/SpeedForge.png" Width="30" Height="30" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="SpeedForge" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBox x:Name="ConnectionInfo" Foreground="{StaticResource LatencyTone}" Text="IP: определяем…" IsReadOnly="True" MinHeight="0" Height="18" MaxWidth="590" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0" FontSize="11" Margin="0,4,0,0"/><TextBlock x:Name="PageTitle" Visibility="Collapsed"/><TextBlock x:Name="PageSubtitle" Visibility="Collapsed"/></StackPanel></DockPanel>
<TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0,18,0,0">
<TabItem Header="Проверка"><ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Expander x:Name="AdvancedPanel" Header="Параметры и выбор сервера" Margin="0,0,0,14"><Border Style="{StaticResource Card}" Padding="16" Margin="0,10,0,0"><ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="OptionsPanel">
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Метод" Style="{StaticResource Label}"/><ComboBox x:Name="MethodFilter" SelectedIndex="0" SelectionChanged="Filters_Changed"><ComboBoxItem Tag="Http" Content="HTTP / HTTPS"/><ComboBoxItem Tag="Iperf3" Content="iPerf3"/><ComboBoxItem Tag="Iperf2" Content="iPerf2 · Билайн"/><ComboBoxItem Tag="All" Content="Все методы"/></ComboBox></StackPanel><StackPanel x:Name="OperatorPanel" Grid.Column="2"><TextBlock Text="Оператор" Style="{StaticResource Label}"/><ComboBox x:Name="GroupFilter" SelectionChanged="Filters_Changed"/></StackPanel><StackPanel x:Name="CityPanel" Grid.Column="4"><TextBlock Text="Город" Style="{StaticResource Label}"/><ComboBox x:Name="CityFilter" SelectionChanged="Filters_Changed"/></StackPanel><StackPanel x:Name="BeelineTariffPanel" Grid.Column="2" Grid.ColumnSpan="3" Visibility="Collapsed"><TextBlock Text="Скорость предусмотренная тарифом, Мбит/с" Style="{StaticResource Label}"/><ComboBox x:Name="BeelineTariff" IsEditable="False" SelectionChanged="BeelineTariff_Changed" ToolTip="Выберите скорость тарифа: от 100 до 1000 Мбит/с."/></StackPanel></Grid>
<TextBlock Text="Сервер" Style="{StaticResource Label}" Margin="0,12,0,6"/><ComboBox x:Name="ServerCombo" SelectionChanged="Server_Changed"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
<CheckBox x:Name="BothCheck" Content="Автоматически проверить доступные направления" IsChecked="True" Checked="Profile_Changed" Unchecked="Profile_Changed"/>
<CheckBox x:Name="GeoIpCheck" Content="Геолокация по IP · выбирать ближайший сервер при запуске" ToolTip="Внешний IP определяется через STUN Cloudflare/Twilio или HTTPS ifconfig.me/ipify. Для геолокации и ASN IP передаётся в ipwho.is и RIPEstat. Положение приблизительное; настройка сохраняется." IsChecked="True" Checked="GeoIp_Changed" Unchecked="GeoIp_Changed"/>
<CheckBox x:Name="Iperf2ProfilesCheck" Content="Билайн · 12 профилей: 100 / 500 / 1000 Мбит/с" IsChecked="True" Visibility="Collapsed" Checked="Profile_Changed" Unchecked="Profile_Changed"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel x:Name="DirectionPanel"><TextBlock Text="Ручное направление" Style="{StaticResource Label}"/><ComboBox x:Name="DirectionCombo" SelectedIndex="0" SelectionChanged="Direction_Changed"><ComboBoxItem Tag="Download" Content="На ПК · загрузка"/><ComboBoxItem Tag="Upload" Content="С ПК · отдача"/><ComboBoxItem Tag="Bidirectional" Content="Оба одновременно"/></ComboBox></StackPanel><StackPanel x:Name="ProtocolPanel" Grid.Column="2"><TextBlock Text="Протокол" Style="{StaticResource Label}"/><ComboBox x:Name="TransportCombo" SelectedIndex="0" SelectionChanged="Transport_Changed"><ComboBoxItem Tag="Tcp" Content="TCP"/><ComboBoxItem Tag="Udp" Content="UDP"/></ComboBox></StackPanel><StackPanel x:Name="DurationPanel" Grid.Column="4"><TextBlock Text="Длительность, с" Style="{StaticResource Label}"/><TextBox x:Name="DurationBox" Text="8"/></StackPanel><StackPanel x:Name="ParallelPanel" Grid.Column="6"><TextBlock Text="Потоки" Style="{StaticResource Label}"/><TextBox x:Name="ParallelBox" Text="4"/></StackPanel></Grid>
<Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel x:Name="RatePanel"><TextBlock Text="Лимит Мбит/с · 0 = максимум" Style="{StaticResource Label}"/><TextBox x:Name="RateBox" Text="0" TextChanged="Rate_Changed"/></StackPanel><Button x:Name="ClearRateButton" Grid.Column="2" Content="Снять лимит" Click="ClearRate_Click" VerticalAlignment="Bottom"/><StackPanel x:Name="RateFamilyPanel" Grid.Column="4"><TextBlock Text="Семейство IP" Style="{StaticResource Label}"/><ComboBox x:Name="FamilyCombo" SelectedIndex="0"><ComboBoxItem Tag="Automatic" Content="Автоматически"/><ComboBoxItem Tag="IPv4" Content="IPv4"/><ComboBoxItem Tag="IPv6" Content="IPv6"/></ComboBox></StackPanel></Grid>
<WrapPanel><CheckBox x:Name="LatencyCheck" Content="ICMP-задержка" IsChecked="True" Margin="0,12,18,0"/><CheckBox x:Name="PrivateCheck" Content="Локальная сеть" Margin="0,12,0,0"/><CheckBox x:Name="ExpertCheck" Visibility="Collapsed" IsChecked="True"/></WrapPanel>
<TextBlock x:Name="ObservationText" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
<Expander Header="Свой сервер"><StackPanel Margin="0,10,0,0"><TextBlock Text="Адрес" Style="{StaticResource Label}"/><TextBox x:Name="CustomHost" TextChanged="Custom_Changed"/><TextBlock Text="Порт" Style="{StaticResource Label}"/><TextBox x:Name="CustomPort" TextChanged="Custom_Changed" Text="5201"/><ComboBox x:Name="CustomEngine" SelectionChanged="Custom_Changed" SelectedIndex="0"><ComboBoxItem Tag="Iperf3" Content="iPerf3"/><ComboBoxItem Tag="Iperf2" Content="iPerf2"/><ComboBoxItem Tag="Http" Content="SpeedForge Endpoint"/></ComboBox><TextBlock Text="Для HTTP(S) — полный URL файла" Style="{StaticResource Label}"/><TextBox x:Name="CustomUrl" TextChanged="Custom_Changed"/><TextBlock Text="Ключ SpeedForge Endpoint" Style="{StaticResource Label}"/><PasswordBox x:Name="SessionKey"/></StackPanel></Expander>
<Button x:Name="ProbeButton" Visibility="Collapsed" Click="Probe_Click"/>
</StackPanel></ScrollViewer></Border></Expander>
<UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
<Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="20"><StackPanel><TextBlock Text="↓  НА ПК" Foreground="{StaticResource DownloadTone}" FontSize="12"/><TextBlock x:Name="DownloadValue" Foreground="{StaticResource DownloadTone}" Text="—" FontSize="40" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Мбит/с · загрузка" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="DownloadStatus" Text="Не проверено" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Margin="4,0,4,0" Padding="20"><StackPanel><TextBlock x:Name="UploadHeading" Text="↑  С ПК" Foreground="{StaticResource UploadTone}" FontSize="12"/><TextBlock x:Name="UploadValue" Foreground="{StaticResource UploadTone}" Text="—" FontSize="40" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="UploadUnits" Text="Мбит/с · отдача" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="UploadStatus" Text="Не проверено" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/><TextBlock x:Name="UploadTxDetail" Text="" Foreground="{StaticResource QualityModerate}" FontSize="11" Margin="0,3,0,0" Visibility="Collapsed" ToolTip="Скорость локального отправителя UDP. Это не подтверждённая скорость соединения: данные могли быть отброшены дальше по пути."/></StackPanel></Border>
<Border Style="{StaticResource Card}" Margin="8,0,0,0" Padding="20"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ПИНГ" Foreground="{StaticResource LatencyTone}" FontSize="12"/><TextBlock x:Name="PingValue" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="мс · ICMP" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="ДЖИТТЕР" Foreground="{StaticResource LatencyTone}" FontSize="12"/><TextBlock x:Name="JitterValue" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock x:Name="JitterSource" Text="мс" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Grid><TextBlock x:Name="PacketLossValue" Text="Потери: —" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0"/><TextBlock x:Name="LatencyContext" Foreground="{StaticResource LatencyTone}" Text="До начала передачи" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></Border>
</UniformGrid>
<Border Grid.Row="2" Style="{StaticResource Card}" Padding="18" Height="180"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock x:Name="PeakValue" Foreground="{StaticResource QualityModerate}" DockPanel.Dock="Right" Text="Пик —" FontSize="11"/><TextBlock x:Name="ChartTitle" Text="Скорость во времени" FontSize="13"/></DockPanel><Grid Grid.Row="1" Margin="0,18,0,10"><Canvas x:Name="ChartCanvas" ClipToBounds="True" SizeChanged="Chart_SizeChanged"/><TextBlock x:Name="ChartHint" Text="Нажмите «Проверить скорость»" Foreground="#667D99" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><DockPanel Grid.Row="2"><TextBlock x:Name="TimeInfo" Foreground="{StaticResource QualityModerate}" Text="" FontSize="11"/><TextBlock DockPanel.Dock="Right" FontSize="11" HorizontalAlignment="Right"><Run Text="● На ПК" Foreground="{StaticResource DownloadTone}"/><Run Text="    ● С ПК" Foreground="{StaticResource UploadTone}"/></TextBlock></DockPanel></Grid></Border>
<StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="ServerDetail" Foreground="{StaticResource LatencyTone}" FontSize="12" HorizontalAlignment="Center"/><TextBlock x:Name="RateSummary" Foreground="{StaticResource DownloadTone}" Text="Скорость: максимум" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,10" TextWrapping="Wrap" TextAlignment="Center"/><Button x:Name="RunButton" Content="Проверить скорость" Click="Run_Click" Style="{StaticResource Primary}" Width="280" HorizontalAlignment="Center"/><Button x:Name="CancelButton" Visibility="Collapsed" Click="Cancel_Click"/><ProgressBar x:Name="RunProgress" Height="2" Margin="0,8,0,6" Background="#1C2A3D" Foreground="{StaticResource DownloadTone}" BorderThickness="0"/><TextBlock x:Name="PhaseTitle" Text="Готово" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock x:Name="ReadyText" Visibility="Collapsed"/><TextBlock x:Name="SummaryText" Text="Доступные направления определяются проверкой" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/><Border x:Name="ErrorPanel" Background="#30212A" CornerRadius="6" Padding="10" Margin="0,10,0,0" Visibility="Collapsed"><TextBlock x:Name="ErrorText" Foreground="{StaticResource QualityPoor}" FontSize="12" TextWrapping="Wrap"/></Border><TextBlock x:Name="MeasurementNotice" Text="Из-за особенностей тестируемых серверов результаты могут отличаться от фактической скорости линии." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" MaxWidth="850" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/><TextBox x:Name="ProgressBox" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"/></StackPanel>
</Grid></ScrollViewer></TabItem><TabItem Header="История"><Border Style="{StaticResource Card}"><DockPanel><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,18"><Button Content="Обновить" Click="Refresh_Click" Margin="0,0,10,0"/><Button Content="Открыть debug" Click="HistoryDebug_Click" Margin="0,0,10,0"/><Button Content="Подробный JSON" Click="TechnicalExport_Click"/></WrapPanel><DataGrid x:Name="HistoryList"><DataGrid.Resources><Style x:Key="HistoryStatus" TargetType="TextBlock" BasedOn="{StaticResource GridText}"><Setter Property="ToolTip" Value="{Binding StatusDescription}"/><Setter Property="FontSize" Value="12"/></Style><Style x:Key="HistoryProfile" TargetType="TextBlock" BasedOn="{StaticResource GridText}"><Setter Property="ToolTip" Value="{Binding ProfileDescription}"/></Style><Style x:Key="HistoryServer" TargetType="TextBlock" BasedOn="{StaticResource GridText}"><Setter Property="ToolTip" Value="{Binding Host}"/></Style><Style x:Key="HistoryIp" TargetType="TextBlock" BasedOn="{StaticResource GridText}"><Setter Property="Foreground" Value="{StaticResource LatencyTone}"/><Setter Property="ToolTip" Value="{Binding ClientIpDescription}"/></Style></DataGrid.Resources><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Время" Binding="{Binding Started, StringFormat=dd.MM HH:mm}" Width="100"/><DataGridTextColumn ElementStyle="{StaticResource HistoryServer}" Header="Сервер" Binding="{Binding ServerLabel}" Width="*" MinWidth="100"/><DataGridTextColumn ElementStyle="{StaticResource HistoryIp}" Header="Исходный IP" Binding="{Binding ClientIpLabel}" Width="140"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Метод" Binding="{Binding Engine}" Width="60"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Куда" Binding="{Binding DirectionLabel}" Width="70"/><DataGridTextColumn ElementStyle="{StaticResource HistoryProfile}" Header="Профиль" Binding="{Binding ProfileLabel}" Width="100"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="↓ Мбит/с" Binding="{Binding DownloadMbps, StringFormat=F2, TargetNullValue=—}" Width="75"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="↑ Мбит/с" Binding="{Binding UploadMbps, StringFormat=F2, TargetNullValue=—}" Width="75"/><DataGridTextColumn ElementStyle="{StaticResource HistoryStatus}" Header="Итог" Binding="{Binding StatusLabel}" Width="140"/></DataGrid.Columns></DataGrid></DockPanel></Border></TabItem>
<TabItem Header="Серверы"><Border Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,0,0,18"><TextBox x:Name="CatalogSearch" TextChanged="CatalogSearch_Changed" ToolTip="Поиск по оператору, городу или адресу"/><TextBlock Text="Двойной щелчок выбирает сервер для проверки. Доступность серверов меняется." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/></StackPanel><StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0"><Grid x:Name="CatalogEditor"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Адрес выбранного сервера" Style="{StaticResource Label}"/><TextBox x:Name="CatalogHost" IsEnabled="False" ToolTip="Имя сервера или IP. Порты и пути тестовых файлов сохраняются."/></StackPanel><Button x:Name="CatalogSaveButton" Grid.Column="1" Content="Сохранить адрес" IsEnabled="False" Click="CatalogSave_Click" VerticalAlignment="Bottom" Margin="0,0,10,0"/><Button x:Name="CatalogResetButton" Grid.Column="2" Content="Вернуть исходный" IsEnabled="False" Click="CatalogReset_Click" VerticalAlignment="Bottom"/></Grid><TextBlock x:Name="CatalogPort" Text="Выберите сервер в списке" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/><TextBlock x:Name="CatalogEditStatus" Foreground="#8DD9C0" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"/></StackPanel><DataGrid x:Name="CatalogGrid" SelectionMode="Single" SelectionChanged="Catalog_SelectionChanged" MouseDoubleClick="Catalog_DoubleClick"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Оператор" Binding="{Binding Group}" Width="110"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Город" Binding="{Binding City}" Width="120"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Адрес" Binding="{Binding Host}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Метод" Binding="{Binding MethodLabel}" Width="85"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Порт" Binding="{Binding Port}" Width="70"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Контрольная проверка" Binding="{Binding Observed}" Width="230"/></DataGrid.Columns></DataGrid></DockPanel></Border></TabItem>
<TabItem Header="Инструменты"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Измерительные модули" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="iPerf3 3.22 и iPerf2 2.2.2 встроены и проверяются по SHA-256. Можно перенести один exe на другой компьютер. Лицензии и исходники компонентов тоже внутри." Foreground="{StaticResource Muted}" Margin="0,12,0,16"/><WrapPanel><Button Content="Выбрать свой iPerf3" Click="TrustIperf3_Click" Margin="0,0,10,0"/><Button Content="Выбрать свой iPerf2" Click="TrustIperf2_Click" Margin="0,0,10,0"/><Button Content="Лицензии и исходники" Click="LicensesExport_Click"/></WrapPanel><TextBlock Text="iPerf2: UDP Билайн и собственные серверы. Обратное направление определяется реальным тестом." Foreground="{StaticResource Muted}" Margin="0,14,0,0"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Сравнение двух точек" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Первая точка выбирается на экране проверки. Оба запуска используют один профиль." Foreground="{StaticResource Muted}" Margin="0,12,0,16"/><ComboBox x:Name="CompareCombo"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button x:Name="CompareButton" Content="Сравнить последовательно" Click="Compare_Click" Margin="0,14,0,0" HorizontalAlignment="Left"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Источники и методика" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="HTTP показывает скорость передачи полезных данных до выбранного сервера. iPerf использует собственный протокол. Показатели этих методов могут отличаться. Лимит 0 включает максимальную скорость HTTP, TCP и UDP. В обратном iPerf2 запрашивается 100 Гбит/с на поток, поскольку нулевой запрос сервер заменяет на 1 Мбит/с. Заблокированный ICMP не мешает тесту скорости." Foreground="{StaticResource Muted}" Margin="0,12,0,16"/><WrapPanel><Button Content="Каталог iPerf3" Click="DocsCatalog_Click" Margin="0,0,10,10"/><Button Content="Серверы МТС" Click="DocsMts_Click" Margin="0,0,10,10"/><Button Content="HOSTKEY" Click="DocsHostkey_Click" Margin="0,0,10,10"/><Button Content="Selectel" Click="DocsSelectel_Click" Margin="0,0,10,10"/><Button Content="RastrNet" Click="DocsRastr_Click" Margin="0,0,10,10"/></WrapPanel></StackPanel></Border>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Отладка"><Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Grid.Row="0" Margin="0,0,0,14"><WrapPanel><Button x:Name="DebugProbeButton" Content="Проверить направления · 3 с" Click="Probe_Click" Margin="0,0,10,8"/><Button Content="Сохранить debug ZIP" Click="DebugExport_Click" Margin="0,0,10,8"/><Button Content="Папка журнала" Click="DebugFolder_Click" Margin="0,0,10,8"/></WrapPanel><TextBlock Text="Выберите запуск ниже. ZIP сохраняет оба направления и все попытки. Историческая доступность не блокирует новый тест." Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel><DataGrid x:Name="DebugRuns" Grid.Row="1" Height="145" SelectionChanged="DebugRuns_Changed" Margin="0,0,0,14"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Время" Binding="{Binding Started, StringFormat=HH:mm:ss}" Width="95"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Направление" Binding="{Binding Direction}" Width="110"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Статус" Binding="{Binding Status}" Width="120"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Приём Мбит/с" Binding="{Binding ReceiverMbps, StringFormat=F2}" Width="110"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="TX Мбит/с" Binding="{Binding SenderMbps, StringFormat=F2}" Width="100"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Порт" Binding="{Binding Port}" Width="65"/><DataGridTextColumn ElementStyle="{StaticResource GridText}" Header="Причина" Binding="{Binding ErrorCode}" Width="*"/></DataGrid.Columns></DataGrid><TextBox x:Name="DebugBox" Grid.Row="2" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#0B1420" Padding="12"/></Grid></Border></TabItem></TabControl></Grid></Grid></Window>
